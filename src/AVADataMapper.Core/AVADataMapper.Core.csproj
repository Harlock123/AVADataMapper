<Project Sdk="Microsoft.NET.Sdk">
  <!-- Reading schemas (live catalogs and DDL scripts), the mapping, its checks, transforms, profiling, dry runs,
       migrations and the parity hand-off. No Avalonia, so the tests check it without a window. -->
  <PropertyGroup>
    <RootNamespace>AVADataMapper.Core</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AVADataMapper.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.4" />
    <!-- SqlClient 6.1.4 pulls System.Security.Cryptography.Pkcs 9.0.11, which has advisories; take the patched one. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" Version="180.107.0" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
  </ItemGroup>
</Project>
